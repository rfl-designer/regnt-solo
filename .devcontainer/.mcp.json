{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": ["artisan", "boost:mcp"]
        },
        "soloboard": {
            "type": "http",
            "url": "https://regnt.sophostech.com.br/mcp",
            "headers": {
                "Authorization": "Bearer ${SOLOBOARD_MCP_KEY}"
            }
        }
    }
}
